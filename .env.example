# Postgres (Neon). Use the pooled connection string on Vercel.
DATABASE_URL=

# Auth.js v5 / NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 only auto-trusts the Host header in development. Behind Render's
# proxy this must be true, or every sign-in fails with UntrustedHost.
AUTH_TRUST_HOST=true

# Cloudinary — server side. The API secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary — browser side. Cloud name only; used to build delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Seed credentials for the first admin account (pnpm prisma db seed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# The resort's contact numbers — the starting values only. The live numbers are
# edited by the owner at /admin/settings; these seed a fresh database and are the
# fallback if those rows are ever missing. WhatsApp: digits, country code first.
RESORT_WHATSAPP=
RESORT_PHONE=
RESORT_PHONE_DISPLAY=
